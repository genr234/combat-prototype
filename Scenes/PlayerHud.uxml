<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scenes/PlayerHud.uss?fileID=7433441132597879392&amp;guid=ddce8e8fd13644bf89b82b2fddd699c8&amp;type=3#PlayerHud" />
    <ui:VisualElement name="hud-container" class="hud-container">
        <ui:VisualElement name="health-section" class="health-section" style="display: flex; visibility: visible; -unity-font-definition: url(&quot;project://database/Assets/UI%20Pack/Font/Kenney%20Future%20Narrow.ttf?fileID=12800000&amp;guid=c9d8013f7c69642b3b5346ac686690b6&amp;type=3#Kenney Future Narrow&quot;);">
            <ui:Label name="health-label" class="health-label" />
            <ui:VisualElement name="health-bar-container" class="health-bar-container" style="visibility: visible;">
                <ui:VisualElement name="health-bar-fill" class="health-bar-fill" style="width: 100%;" />
                <ui:Label name="health-text" text="0" enabled="true" class="health-text" style="display: flex;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ammo-section" class="ammo-section">
            <ui:Label name="weapon-name" class="weapon-name" />
            <ui:VisualElement name="ammo-container" class="ammo-container">
                <ui:Label name="ammo-current" class="ammo-current" />
                <ui:Label name="ammo-separator" class="ammo-separator" />
                <ui:Label name="ammo-total" class="ammo-total" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="reload-container" class="reload-container">
        <ui:Label name="reload-text" text="RELOADING..." class="reload-text" />
        <ui:VisualElement name="reload-bar-container" class="reload-bar-container">
            <ui:VisualElement name="reload-bar-fill" class="reload-bar-fill" />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:VisualElement name="dash-container" class="dash-container">
        <ui:Label name="dash-label" text="DASH" class="dash-label" style="-unity-font-definition: url(&quot;project://database/Assets/UI%20Pack/Font/Kenney%20Future.ttf?fileID=12800000&amp;guid=f19ee655bfc4e421882bf114b5042c91&amp;type=3#Kenney Future&quot;);" />
        <ui:VisualElement name="dash-cooldown-bar-container" class="dash-cooldown-bar-container">
            <ui:VisualElement name="dash-cooldown-bar" class="dash-cooldown-bar" />
        </ui:VisualElement>
        <ui:Label text="space to activate!&#10;" style="color: rgb(100, 200, 255); -unity-font-definition: url(&quot;project://database/Assets/UI%20Pack/Font/Kenney%20Future.ttf?fileID=12800000&amp;guid=f19ee655bfc4e421882bf114b5042c91&amp;type=3#Kenney Future&quot;);" />
    </ui:VisualElement>
    <ui:VisualElement name="lockon-indicator" class="lockon-indicator" style="bottom: 995px; left: 958px; align-items: center;">
        <ui:Label name="lockon-text" text="● LOCKED" class="lockon-text" />
    </ui:VisualElement>
</ui:UXML>
